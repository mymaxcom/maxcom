<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later always show the system splash screen first: the MAXCOM mark (the adaptive icon
         foreground, which has the safe margin the splash needs) on the kiosk glass colour, then launch_background
         (the MAXCOM wordmark on the same colour) until Flutter draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/surau_glass</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
    </style>
</resources>
